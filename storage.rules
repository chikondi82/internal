rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isWorkspaceMember() {
      return request.auth != null
        && (request.auth.token.email == 'chikondigahimbare@gmail.com'
            || request.auth.token.vgfWorkspace == true
            || (firestore.exists(/databases/(default)/documents/workspaceAdmins/$(request.auth.uid))
                && firestore.get(/databases/(default)/documents/workspaceAdmins/$(request.auth.uid)).data.enabled == true)
            || (firestore.exists(/databases/(default)/documents/hrAccess/$(request.auth.uid))
                && firestore.get(/databases/(default)/documents/hrAccess/$(request.auth.uid)).data.enabled == true));
    }
    match /avatars/{userId}/{allPaths=**} {
      allow read: if isWorkspaceMember();
      allow write: if isWorkspaceMember()
        && (request.auth.uid == userId
            || request.auth.token.email == 'chikondigahimbare@gmail.com');
    }
    match /posts/{userId}/{allPaths=**} {
      allow read: if isWorkspaceMember();
      allow write: if isWorkspaceMember()
        && (request.auth.uid == userId
            || request.auth.token.email == 'chikondigahimbare@gmail.com');
    }
    match /internReports/{authorUid}/{reportId}/{fileName} {
      function reportExists() {
        return firestore.exists(/databases/(default)/documents/internReports/$(reportId));
      }
      function canReadReportFile() {
        return isWorkspaceMember()
          && (request.auth.token.email == 'chikondigahimbare@gmail.com'
              || (firestore.exists(/databases/(default)/documents/workspaceAdmins/$(request.auth.uid))
                  && firestore.get(/databases/(default)/documents/workspaceAdmins/$(request.auth.uid)).data.enabled == true)
              || (reportExists()
                  && (firestore.get(/databases/(default)/documents/internReports/$(reportId)).data.authorUid == request.auth.uid
                      || firestore.get(/databases/(default)/documents/internReports/$(reportId)).data.currentReviewerUid == request.auth.uid
                      || request.auth.uid in firestore.get(/databases/(default)/documents/internReports/$(reportId)).data.reviewerUids)));
      }
      allow read: if canReadReportFile() || isWorkspaceMember() && request.auth.uid == authorUid && !reportExists();
      allow create: if isWorkspaceMember()
        && request.auth.uid == authorUid
        && !reportExists()
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
      allow update, delete: if isWorkspaceMember()
        && request.auth.uid == authorUid
        && !reportExists();
    }
    match /vgfApplications/{userId}/{applicationId}/{fileId} {
      function ownsDraft() {
        return request.auth != null
          && request.auth.token.vgfApplicant == true
          && request.auth.uid == userId
          && firestore.exists(/databases/(default)/documents/vgfApplications/$(applicationId))
          && firestore.get(/databases/(default)/documents/vgfApplications/$(applicationId)).data.applicantUid == userId
          && firestore.get(/databases/(default)/documents/vgfApplications/$(applicationId)).data.status == 'draft';
      }
      function ownsApplication() {
        return request.auth != null
          && request.auth.token.vgfApplicant == true
          && request.auth.uid == userId
          && firestore.exists(/databases/(default)/documents/vgfApplications/$(applicationId))
          && firestore.get(/databases/(default)/documents/vgfApplications/$(applicationId)).data.applicantUid == userId;
      }
      allow read: if ownsApplication();
      allow create: if ownsDraft()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'image/jpeg', 'image/png'];
      allow update: if ownsDraft()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'image/jpeg', 'image/png'];
      allow delete: if ownsDraft();
    }
    match /{allPaths=**} {
      allow read, write: if isWorkspaceMember()
        && request.auth.token.email == 'chikondigahimbare@gmail.com';
    }
  }
}
